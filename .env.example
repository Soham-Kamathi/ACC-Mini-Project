# FaaS Platform Environment Configuration
# Copy this file to .env: cp .env.example .env

# Database (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./faas_metadata.db

# Kubernetes Configuration
K8S_IN_CLUSTER=false
K8S_NAMESPACE=faas-fn

# Function Scale-to-Zero & Lifecycle
IDLE_TIMEOUT_SECONDS=60
REAPER_INTERVAL_SECONDS=10
DEFAULT_MEMORY_LIMIT=256Mi
DEFAULT_CPU_LIMIT=500m
DEFAULT_TIMEOUT_SECONDS=10

# Security & Sandboxing
SECRET_KEY=faas-super-secret-key-change-in-production-123456789
ALLOW_LOCAL_SANDBOX=false

# Docker Registry
DOCKER_REGISTRY=localhost:5000

# Ngrok Public Tunnel (Optional)
# If using a shared permanent domain, configure your authtoken and domain below:
NGROK_AUTHTOKEN=
NGROK_DOMAIN=discourteously-unmanned-sanora.ngrok-free.dev
