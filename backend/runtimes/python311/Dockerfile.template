FROM python:3.11-slim

# Prevent python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8080

WORKDIR /app

# Install dependencies if present
COPY requirements.txt* /app/
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi

# Copy runtime server and user function code
COPY server.py /app/server.py
COPY handler.py /app/handler.py

# Create non-privileged user for security isolation
RUN useradd -u 10001 -m -s /bin/sh faasuser && \
    chown -R faasuser:faasuser /app

USER faasuser

EXPOSE 8080

HEALTHCHECK --interval=2s --timeout=2s --start-period=1s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/healthz')" || exit 1

CMD ["python3", "server.py"]
